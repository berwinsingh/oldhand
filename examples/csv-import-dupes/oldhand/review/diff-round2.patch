+        db = os.path.join(tempfile.mkdtemp(), "t.db")
+        conn = connect(db)
+        self.addCleanup(conn.close)
+        import_id = start_import(conn, "t.csv")
+        reader = sqlite3.connect(db, isolation_level=None)
+        self.addCleanup(reader.close)
+        reader.execute("BEGIN")
+        reader.execute("SELECT COUNT(*) FROM records").fetchone()  # SHARED lock: the batch COMMIT is refused
+        retries = []
 
+        def release(msg):
+            retries.append(msg)
+            if reader.in_transaction:
+                reader.execute("ROLLBACK")
+
+        with_retries(lambda: write_batch(conn, import_id, 1, [("A", "a", 1), ("B", "b", 2)]), delay=0, log=release)
